---
import Layout from '../layouts/layout.astro';
---
<Layout titulo="Nosotros">
  <h1>Quiénes somos</h1>
  <section class="nosotros">
    <div class="nosotros__texto">
      <p>
        Espacio Cultural es una organización que reúne a personas
        interesadas en el arte y la creación.
      </p>
      <h2>Nuestro propósito</h2>
      <p>
        Acercar la cultura a la comunidad mediante talleres accesibles
        que fomenten la creatividad, el aprendizaje y el encuentro.
      </p>
    </div>
    <img src="/img/nosotros.jpg" alt="Personas participando en actividades de Espacio Cultural" />
  </section>
</Layout>