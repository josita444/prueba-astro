---
import Layout from "../layouts/layout.astro";
import TarjetaTaller from "../components/tarjetataller.astro";

const destacados = [
	{
		nombre: "Fotografía",
		descripcion:
			"Introducción a la composición y técnicas de fotografía digital.",
		imagen: "img/fotografia1.jpg",
	},
	{
		nombre: "Cerámica",
		descripcion:
			"Creación de objetos utilizando técnicas básicas de modelado.",
		imagen: "img/ceramica2.jpg",
	},
	{
		nombre: "Escritura creativa",
		descripcion:
			"Exploración de relatos breves y ejercicios de escritura..",
		imagen: "img/escritura2.jpg",
	},
	{
		nombre: "Ilustración",
		descripcion:
			"Desarrollo de habilidades de dibujo e ilustración digital.",
		imagen: "/img/ilustracion.jpg",
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
		<Layout titulo="Inicio">
			<section class="bienvenida">
				<h1>¡Bienvenidos a un mundo de <span>creatividad</span>!</h1>

				<p>
					Descubre el arte, comparte tus ideas y vive experiencias
					culturales que inspiran, conectan y transforman.
				</p>

				<a href="#talleres">Explorar talleres ↗</a>
			</section>

			<section>
				<h2>Talleres destacados</h2>
				<div class="grilla">
					{
						destacados.map((t) => (
							<TarjetaTaller
								nombre={t.nombre}
								descripcion={t.descripcion}
								imagen={t.imagen}
							/>
						))
					}
				</div>
			</section>
		</Layout>
	</body>
</html>
